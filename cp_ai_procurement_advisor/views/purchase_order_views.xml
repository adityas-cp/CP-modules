<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_procurement" model="ir.ui.view">
        <field name="name">purchase.order.form.procurement</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mark_quote_received" type="object" string="Mark Quote Received"
                        invisible="not procurement_request_id or quote_submitted or state not in ('draft', 'sent')"
                        help="Use it when the vendor sent the quote by email and you typed the prices in yourself."/>
            </xpath>
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="before">
                <page string="Procurement Quote" name="procurement_quote" invisible="not procurement_request_id">
                    <button name="action_open_procurement_quote_form" type="object" icon="fa-external-link"
                            class="btn-link ps-0" string="Open Vendor Quote Form"
                            help="Opens the page the vendor uses to submit the quote. Open it in a private window to see it as the vendor does."/>
                    <group>
                        <group string="Vendor Offer">
                            <field name="procurement_request_id"/>
                            <field name="quote_submitted"/>
                            <field name="quote_date" invisible="not quote_submitted"/>
                            <field name="delivery_cost" readonly="state not in ('draft', 'sent')"/>
                            <field name="installation_cost" readonly="state not in ('draft', 'sent')"/>
                            <field name="vendor_lead_days" readonly="state not in ('draft', 'sent')"/>
                            <field name="warranty_months" readonly="state not in ('draft', 'sent')"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="procurement_total_cc"/>
                            <field name="procurement_delivery_date"/>
                        </group>
                        <group string="Score" invisible="not quote_submitted">
                            <field name="procurement_rank"/>
                            <field name="procurement_score" widget="progressbar"/>
                            <field name="score_price" widget="progressbar"/>
                            <field name="score_delivery" widget="progressbar"/>
                            <field name="score_spec" widget="progressbar"/>
                            <field name="score_performance" widget="progressbar"/>
                            <field name="score_warranty" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="vendor_quote_notes" placeholder="Vendor notes..." readonly="state not in ('draft', 'sent')"/>
                    <separator string="Specification Answers"/>
                    <field name="procurement_compliance_ids" readonly="state not in ('draft', 'sent')">
                        <list editable="bottom" create="0" delete="0">
                            <field name="name" readonly="1"/>
                            <field name="required_value" readonly="1"/>
                            <field name="mandatory" readonly="1"/>
                            <field name="status" decoration-success="status == 'met'"
                                   decoration-warning="status == 'alternative'"
                                   decoration-danger="status == 'not_met'"/>
                            <field name="vendor_comment"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_procurement_ranking" model="ir.ui.view">
        <field name="name">purchase.order.procurement.ranking</field>
        <field name="model">purchase.order</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list string="Quote Ranking" default_order="procurement_rank, id" create="0" delete="0"
                  decoration-muted="not quote_submitted or state == 'cancel'"
                  decoration-bf="procurement_rank == 1">
                <field name="procurement_rank" string="#"/>
                <field name="partner_id"/>
                <field name="name" string="Reference"/>
                <field name="quote_submitted" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="procurement_total_cc"/>
                <field name="procurement_delivery_date"/>
                <field name="warranty_months" optional="show"/>
                <field name="score_price" optional="show"/>
                <field name="score_delivery" optional="show"/>
                <field name="score_spec" optional="show"/>
                <field name="score_performance" optional="show"/>
                <field name="score_warranty" optional="show"/>
                <field name="procurement_score" widget="progressbar"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'purchase'"
                       decoration-info="state in ('draft', 'sent')"/>
                <button name="action_procurement_choose" type="object" string="Choose" class="btn-primary"
                        invisible="not quote_submitted or state not in ('draft', 'sent')"/>
            </list>
        </field>
    </record>
</odoo>
