<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_procurement_rfq" model="mail.template">
            <field name="name">Procurement: Request for Quotation</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">{{ object.company_id.name }} Request for Quotation {{ object.name }}: {{ object.procurement_request_id.title }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to vendors with the specification and the link to the quote form</field>
            <field name="email_layout_xmlid">mail.mail_notification_layout_with_responsible_signature</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        <t t-out="object.company_id.name or ''">YourCompany</t> invites you to quote for
        <strong t-out="object.procurement_request_id.title or ''">Laptops for 25 new hires</strong>
        (reference <strong t-out="object.name or ''">P00015</strong>).
        <br/><br/>
        The attached specification lists every item, its quantity and the required characteristics.
        <t t-if="object.procurement_request_id.deadline">
            The goods are needed by <strong t-out="format_date(object.procurement_request_id.deadline) or ''">12/31/2026</strong>.
        </t>
        <br/><br/>
        Please enter your prices, lead time, warranty and any alternative you propose on our quote form:
    </p>
    <div style="margin: 16px 0px 16px 0px;">
        <a t-att-href="object.get_procurement_quote_url()"
           style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
            Submit your quote
        </a>
    </div>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        If you have any questions, simply reply to this email.
        <br/><br/>
        Best regards,
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div></field>
            <field name="report_template_ids" eval="[(4, ref('cp_ai_procurement_advisor.action_report_procurement_rfq_spec'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
