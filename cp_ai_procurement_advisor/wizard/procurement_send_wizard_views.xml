<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="procurement_send_wizard_view_form" model="ir.ui.view">
        <field name="name">procurement.send.wizard.form</field>
        <field name="model">procurement.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Vendors">
                <div class="alert alert-warning" role="alert" invisible="not budget_warning">
                    <field name="budget_warning" readonly="1"/>
                </div>
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="vendor_ids" widget="many2many_tags"
                           context="{'res_partner_search_mode': 'supplier'}"
                           options="{'no_create_edit': True}"/>
                    <field name="invited_vendor_ids" widget="many2many_tags" invisible="not invited_vendor_ids"/>
                    <field name="send_email"/>
                </group>
                <p class="text-muted">
                    Each vendor gets its own request for quotation, linked to the others as alternatives.
                    The budget and target prices are never shared.
                </p>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
